{
  "name": "life-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --disable-warning=DEP0108 node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect:finance": "node --env-file=.env.local scripts/inspect-finance.mjs",
    "inspect:music": "node --env-file=.env.local scripts/inspect-music.mjs",
    "inspect:meditation": "node --env-file=.env.local scripts/inspect-meditation.mjs",
    "inspect:games": "node --env-file=.env.local scripts/inspect-games.mjs",
    "inspect:games-goi": "node --env-file=.env.local scripts/inspect-games-goi.mjs",
    "inspect:basketball": "node --env-file=.env.local scripts/inspect-basketball.mjs",
    "inspect:races": "node --env-file=.env.local scripts/inspect-races.mjs",
    "inspect:cornhole": "node --env-file=.env.local scripts/inspect-cornhole.mjs",
    "inspect:screen-time": "node --env-file=.env.local scripts/inspect-screen-time.mjs",
    "inspect:movies": "node --env-file=.env.local scripts/inspect-movies.mjs",
    "inspect:secret": "node --env-file=.env.local scripts/inspect-secret.mjs",
    "inspect:books": "node --env-file=.env.local scripts/inspect-books.mjs",
    "inspect:jobs": "node --env-file=.env.local scripts/inspect-jobs.mjs",
    "inspect:recipes": "node --env-file=.env.local scripts/inspect-recipes-doc.mjs",
    "inspect:hikes": "node --env-file=.env.local scripts/inspect-hikes-doc.mjs"
  },
  "dependencies": {
    "googleapis": "^181.0.0",
    "next": "^16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
